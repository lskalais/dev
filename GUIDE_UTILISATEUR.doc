\pard\plain\intbl\f0\fs20\sa80\sb80 Compte inscrit sans accord sign\u233? par les deux parties\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Fonctions de son r\u244?le, mais pas de r\u233?v\u233?lation automatique des informations sensibles de l\u8217?entreprise.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Acqu\u233?reur v\u233?rifi\u233? et accord sign\u233? par les deux parties\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Informations compl\u233?mentaires autoris\u233?es du dossier, notamment identit\u233?, localisation pr\u233?cise et donn\u233?es financi\u232?res disponibles.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Document de data room\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Acc\u232?s soumis aux autorisations documentaires et \u224? la p\u233?riode de validit\u233?, en plus des conditions du dossier.\cell
\row
\pard\plain\s0\f0\fs22\sa100\par
\pard\plain\s0\f0\fs22\sa140 {\b Trois validations diff\u233?rentes sont \u224? distinguer :}\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 1.\tab la v\u233?rification du profil ou du compte ;\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 2.\tab la signature de l\u8217?accord de confidentialit\u233? pour une op\u233?ration ;\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 3.\tab l\u8217?autorisation d\u8217?acc\u232?s \u224? chaque document.\par
\pard\plain\s0\f0\fs22\sa140 Ne placez jamais un nom d\u8217?entreprise, une adresse pr\u233?cise ou un indice permettant de l\u8217?identifier dans un champ destin\u233? \u224? un aper\u231?u anonymis\u233?.\par
\pard\plain\s2\f0\b\cf1\fs30\keepn\sb240\sa140 4. Parcours acqu\u233?reur / investisseur\par
\pard\plain\s3\f0\b\cf1\fs25\keepn\sb240\sa140 4.1 Faire v\u233?rifier son profil KYC\par
\pard\plain\s0\f0\fs22\sa140 Dans le tableau de bord, rep\u233?rez {\b V\u233?rification de votre profil}.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 1.\tab S\u233?lectionnez le type de pi\u232?ce.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 2.\tab Choisissez un fichier lisible.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 3.\tab Utilisez le bouton de t\u233?l\u233?versement.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 4.\tab V\u233?rifiez que le document appara\u238?t dans la liste.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 5.\tab Consultez r\u233?guli\u232?rement le statut et les \u233?ventuelles demandes de compl\u233?ment.\par
