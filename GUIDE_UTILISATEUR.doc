\pard\plain\intbl\f0\fs20\sa80\sb80 \b Probl\u232?me\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 \b V\u233?rifications et actions\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Un champ ou un bouton signale une erreur\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Lisez le message, corrigez les champs concern\u233?s, puis soumettez une seule fois \u224? nouveau.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 La session a expir\u233? ou la vue ne peut pas \u234?tre restaur\u233?e\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Ouvrez \u224? nouveau l\u8217?accueil ou la connexion depuis leur adresse, puis reconnectez-vous. V\u233?rifiez si la pr\u233?c\u233?dente action a \u233?t\u233? enregistr\u233?e avant de la r\u233?p\u233?ter.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Une page affiche HTTP 500\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Notez l\u8217?heure, l\u8217?adresse de la page et l\u8217?action r\u233?alis\u233?e. Essayez une page fra\u238?che. Si l\u8217?erreur persiste, signalez-la \u224? ALP ; ne la consid\u233?rez pas comme une confirmation de r\u233?ussite.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 La page ne s\u8217?ouvre pas\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 V\u233?rifiez l\u8217?adresse et la connexion. Sur un autre poste, remplacez {\f1 localhost} par l\u8217?adresse serveur communiqu\u233?e par ALP.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 L\u8217?identit\u233? de l\u8217?entreprise est encore masqu\u233?e\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 V\u233?rifiez la validation KYC et les signatures des deux parties dans ce dossier.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Un document est visible sans lien de t\u233?l\u233?chargement\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 V\u233?rifiez l\u8217?autorisation du c\u233?dant, la validation ALP et la date d\u8217?expiration. Contactez le responsable du dossier si n\u233?cessaire.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Un fichier est refus\u233?\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 V\u233?rifiez le format propos\u233?, la taille maximale de 20 Mio, le type de pi\u232?ce choisi et la lisibilit\u233? du fichier. Ne changez pas simplement son extension.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Le teaser n\u8217?est plus modifiable\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 V\u233?rifiez s\u8217?il a \u233?t\u233? pris en charge par un courtier ; demandez-lui la correction.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Aucun r\u233?sultat de recherche\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Retirez les filtres avec {\b R\u233?initialiser}. V\u233?rifiez la devise et les restrictions des crit\u232?res financiers avant NDA.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Aucun courriel re\u231?u\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Consultez les notifications internes. L\u8217?envoi par courriel d\u233?pend de la configuration du serveur.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Aucun code KYC re\u231?u\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Aucun OTP n\u8217?est envoy\u233? dans cette version ; la v\u233?rification des coordonn\u233?es est manuelle.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Mot de passe oubli\u233?\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Contactez ALP pour l\u8217?attribution d\u8217?un mot de passe temporaire ; aucun parcours public de r\u233?initialisation autonome n\u8217?est d\u233?crit ici.\cell
\row
\trowd\trgaph100\trleft0\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 Une rubrique reste en fran\u231?ais\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 La couverture bilingue n\u8217?est pas encore compl\u232?te.\cell
