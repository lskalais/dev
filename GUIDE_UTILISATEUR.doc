\pard\plain\intbl\f0\fs20\sa80\sb80 Administrateur ALP \u8212? SUPER\cell
\pard\plain\intbl\f0\fs20\sa80\sb80 Administrer les comptes, contenus, messages, partenaires et op\u233?rations selon ses autorisations.\cell
\row
\pard\plain\s0\f0\fs22\sa100\par
\pard\plain\s0\f0\fs22\sa140 Le r\u244?le SUPER n\u8217?est pas propos\u233? dans le formulaire d\u8217?inscription public.\par
\pard\plain\s2\f0\b\cf1\fs30\keepn\sb240\sa140 2. Cr\u233?er un compte et se connecter\par
\pard\plain\s3\f0\b\cf1\fs25\keepn\sb240\sa140 Inscription\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 1.\tab Cliquez sur {\b Cr\u233?er un compte}.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 2.\tab Renseignez votre nom ou celui du repr\u233?sentant l\u233?gal et votre adresse courriel.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 3.\tab S\u233?lectionnez votre r\u244?le.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 4.\tab Compl\u233?tez les informations correspondant \u224? votre profil.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 5.\tab Choisissez un mot de passe d\u8217?au moins {\b 12 caract\u232?res}.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 6.\tab Consultez les informations relatives aux donn\u233?es personnelles et l\u8217?engagement de confidentialit\u233?.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 7.\tab Cliquez sur {\b Cr\u233?er mon compte}.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 8.\tab Lisez le message de confirmation ou corrigez les champs signal\u233?s.\par
\pard\plain\s3\f0\b\cf1\fs25\keepn\sb240\sa140 Informations propres aux acqu\u233?reurs\par
\pard\plain\s0\f0\fs22\sa140 {\b Personne physique :} nationalit\u233?, pays de r\u233?sidence, t\u233?l\u233?phone et profession. Vous pouvez \u233?galement pr\u233?ciser une capacit\u233? financi\u232?re indicative, sa devise et les secteurs recherch\u233?s.\par
\pard\plain\s0\f0\fs22\sa140 {\b Personne morale :} d\u233?nomination sociale, t\u233?l\u233?phone du repr\u233?sentant, forme juridique, pays d\u8217?immatriculation, num\u233?ro RCCM ou registre \u233?quivalent, identifiant fiscal, si\u232?ge social et fonction du repr\u233?sentant l\u233?gal.\par
\pard\plain\s0\f0\fs22\sa140 Utilisez des renseignements exacts et coh\u233?rents avec vos justificatifs. La capacit\u233? financi\u232?re indicative n\u8217?est ni une preuve de financement ni une promesse d\u8217?investissement.\par
\pard\plain\s3\f0\b\cf1\fs25\keepn\sb240\sa140 Connexion\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 1.\tab Ouvrez {\b Connexion}.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 2.\tab Saisissez votre courriel et votre mot de passe.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 3.\tab Cliquez sur {\b Se connecter}.\par
\pard\plain\s0\f0\fs22\li420\fi-420\tx420\sa80 4.\tab Acc\u233?dez au tableau de bord correspondant \u224? votre r\u244?le.\par
\pard\plain\s0\f0\fs22\sa140 Si ALP vous a attribu\u233? un mot de passe temporaire, l\u8217?application impose de choisir et de confirmer un nouveau mot de passe avant de poursuivre.\par
\pard\plain\s0\f0\fs22\sa140 Pour quitter votre espace, utilisez {\b D\u233?connexion}, particuli\u232?rement sur un ordinateur partag\u233?.\par
\pard\plain\s2\f0\b\cf1\fs30\keepn\sb240\sa140 3. Comprendre la confidentialit\u233?\par
\trowd\trgaph100\trleft0\trhdr\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\clcbpat3\cellx4820\clbrdrt\brdrs\brdrw6\clbrdrl\brdrs\brdrw6\clbrdrb\brdrs\brdrw6\clbrdrr\brdrs\brdrw6\clcbpat3\cellx9639
\pard\plain\intbl\f0\fs20\sa80\sb80 \b Situation\cell
